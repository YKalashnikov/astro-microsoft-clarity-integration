{
  "name": "astro-microsoft-clarity-integration",
  "description": "Microsoft Clarity analytics in Astro site",
  "author": "Iurii Kalashnikov",
  "version": "1.1.2",
  "homepage": "https://github.com/YKalashnikov/astro-microsoft-clarity-integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKalashnikov/astro-microsoft-clarity-integration.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "astro-integration",
    "clarity",
    "analytics",
    "microsoft",
    "astro",
    "astro plugin",
    "withastro",
    "astro-component"
